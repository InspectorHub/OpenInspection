#!/usr/bin/env sh
# .githooks/pre-commit — openinspection
#
# Quality gate for commits made inside this repo. Activated automatically by the
# "prepare" npm script on `npm install`/`npm ci`:
#     git config core.hooksPath .githooks
# Bypass (discouraged): git commit --no-verify
#
# Mechanism is .githooks + core.hooksPath (no husky), aligned with the
# superproject and the portal/cms submodules.

# Never run in CI / non-interactive contexts (CI does not commit, but guard anyway).
[ -n "$CI" ] && exit 0

# Memory ceiling so concurrent pre-commits (two parallel agent sessions on this
# machine) don't exhaust RAM and freeze the box. Local-only (CI exited above).
# `:-` keeps any value the caller already exported.
#   NODE_OPTIONS → bound the node heavy steps: tsc type-check (--max-old-space-size
#                  is also set per-script), react-router build for the bundle-size
#                  gate, jscpd for lint:dup, eslint.
case " $NODE_OPTIONS " in *"--max-old-space-size"*) : ;; *) export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=4096" ;; esac

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

FAILED=0

# printf, not echo: POSIX sh echo does not interpret \n or \033 escapes
# (they printed literally under Git Bash), and %b expands them portably.
pass() { printf '  ✓  %b\n' "$1"; }
fail() { printf '  ✗  %b\n' "$1"; FAILED=1; }
step() { printf '\n  →  %b\n' "$1"; }

printf '%b\n' "${BOLD}── OpenInspection (Pre-commit Checks) ───────────────────────────${NC}"

# 1. Type check — SCOPED to what the staged changes can actually affect.
#    Runs tsc (the SAME compiler as CI's authoritative "verify" gate) with
#    --incremental build-info caching, so a warm commit only re-checks what
#    changed and stays fast. (We used tsgo/@typescript/native-preview here before;
#    it was faster cold but unstable under memory pressure — GC death-loops that
#    timed out and left multi-GB zombies. tsc is bounded and predictable.)
#    Tiers:
#      - no staged .ts/.tsx or ts-config files  → skip type check entirely
#        (docs, assets, hooks, fixtures — a markdown edit must not cost seconds)
#      - staged TS confined to server/          → api pass only (type-check:api)
#      - anything touching app/ workers/ packages/ or ts-config files → full (type-check)
STAGED=$(git diff --cached --name-only --diff-filter=ACMRD)
STAGED_TREE=$(git diff --cached --name-only --diff-filter=ADR)
TS_STAGED=$(echo "$STAGED" | grep -E '\.(ts|tsx)$' || true)
CONFIG_STAGED=$(echo "$STAGED" | grep -E '^(tsconfig|package\.json|package-lock\.json|vite\.config|react-router\.config|worker-configuration)' || true)

#    The full tier used to shell out to `npm run type-check`, which regenerates
#    two type artifacts before compiling. Measured on this repo, warm:
#      paraglide compile   ~27s   ← app/paraglide/, from messages/ + project.inlang/
#      react-router typegen ~30s  ← .react-router/types/, from the route TREE
#      tsc app + tsc api    ~14s
#    So three quarters of a ~76s "type check" was generating inputs, not checking
#    types. They are pure functions of their own inputs: an edit that cannot reach
#    a generator's input cannot change its output. Regenerate one only when the
#    staged changes do reach it, or when its output is missing (fresh clone, after
#    a clean). `npm run type-check` still runs both unconditionally — that is what
#    CI's verify gate uses, and what the failure messages below point developers at.
#    (The api tier never needed either: tsconfig.api.json includes server/** alone.)
needs_paraglide() {
    [ -d app/paraglide ] || return 0
    echo "$STAGED" | grep -qE '^(messages/|project\.inlang/)'
}
needs_typegen() {
    [ -d .react-router/types ] || return 0
    echo "$STAGED" | grep -qE '^(app/routes\.ts|react-router\.config\.ts)$' && return 0
    # Editing a route module's body does not change its generated types — those
    # infer from `typeof loader` when tsc runs. A route file APPEARING or
    # DISAPPEARING changes the tree, and that does.
    echo "$STAGED_TREE" | grep -qE '^app/routes/'
}

step "Type check"
if [ -z "$TS_STAGED" ] && [ -z "$CONFIG_STAGED" ]; then
    pass "Skipped — no staged TypeScript/config changes (CI verify remains the full gate)"
elif [ -z "$CONFIG_STAGED" ] && [ -z "$(echo "$TS_STAGED" | grep -vE '^(server|tests)/')" ]; then
    if npm run type-check:api > /dev/null 2>&1; then
        pass "Type check passed (tsc, api pass only — staged TS confined to server/ and tests/)"
    else
        fail "Type check failed  →  npm run type-check:api"
    fi
else
    GEN_OK=1
    GEN_NOTE=""
    if needs_paraglide; then
        if npm run i18n:compile > /dev/null 2>&1; then
            GEN_NOTE="${GEN_NOTE}, regenerated messages"
        else
            GEN_OK=0
        fi
    fi
    if [ "$GEN_OK" -eq 1 ] && needs_typegen; then
        if npx react-router typegen > /dev/null 2>&1; then
            GEN_NOTE="${GEN_NOTE}, regenerated route types"
        else
            GEN_OK=0
        fi
    fi
    if [ "$GEN_OK" -eq 0 ]; then
        fail "Type generation failed  →  npm run type-check"
    elif npm run type-check:app > /dev/null 2>&1 && npm run type-check:api > /dev/null 2>&1; then
        pass "Type check passed (tsc${GEN_NOTE})"
    else
        fail "Type check failed  →  npm run type-check"
    fi
fi

# 2. Lint & Fix — ONE eslint process over every staged file (see .lintstagedrc).
#    eslint's cost here is the type-information program, not the file count:
#    `parserOptions.project` names both tsconfigs, so any invocation builds the app
#    program AND the api program before it checks a single line. Four parallel
#    groups paid for that four times over, and quadrupled peak memory on a 16GB
#    box. One process runs inside the 4GB ceiling set above — including commits
#    that stage server/index.ts, which is exempt from type-aware rules precisely
#    because no heap this machine can spare was enough (see eslint.config.js).
step "Lint & Fix"
if npx lint-staged; then
    pass "Lint & Fix passed"
else
    fail "Lint failed  →  npx lint-staged"
fi

# 3. Conformance gates, all in ONE node process (scripts/run-gates.mjs):
#      DS tokens · SVG dimensions · migration-reference hygiene · large-file
#      ratchet · calendar timezone-safety · duplicate-code ceiling
#    Each was its own `node scripts/check-*.mjs` spawn. The checks themselves scan
#    a few hundred files in milliseconds; what cost 0.7-1.3s apiece was node
#    starting up, so paying it six times was almost all of the 5.5s these gates
#    took. Merged: 1.9s. The runner prints the same per-gate ✓/✗ lines, runs every
#    gate even after one fails, and shows violations only for the ones that did.
#    CI still runs them individually via `npm run lint` -- that stays the
#    authoritative gate, and jscpd is a child process either way.
step "Conformance gates"
if node scripts/run-gates.mjs; then
    :
else
    FAILED=1
fi

# NOTE: the Worker bundle-size gate lives in .githooks/pre-push, not here. The
#    bundle can only break at deploy, and its check runs the REAL build pipeline
#    (~1-2 min), so paying it on every commit was overkill. pre-push builds it
#    once per push instead; CI's verify remains the authoritative final gate.

if [ "$FAILED" -eq 1 ]; then
    printf '\n%b\n' "${RED}Pre-commit checks failed. Fix the errors before committing.${NC}"
    exit 1
fi

printf '\n%b\n' "${GREEN}All pre-commit checks passed.${NC}"
exit 0
