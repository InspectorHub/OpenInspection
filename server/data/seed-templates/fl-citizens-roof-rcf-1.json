        "items": [
          {
            "id": "form_application_policy_number",
            "label": "Application/Policy #:",
            "type": "text",
            "description": "Printed at the top of page 1 beside Applicant/Insured Name. It comes from the Citizens application or policy, so nothing in the inspection can supply it."
          }
        ]
      },
      {
