{
  "name": "@inspectorhub/field-ui",
  "version": "0.0.0",
  "description": "The OpenInspection field inspection editor as an embeddable React package.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/InspectorHub/OpenInspection",
    "directory": "packages/field-ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "lib0": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "y-indexeddb": "^9.0.0",
    "y-protocols": "^1.0.0",
    "yjs": "^13.6.0"
  },
  "scripts": {
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/i18n/generated --strategy globalVariable baseLocale --output-structure locale-modules --emit-ts-declarations && tsup"
  }
}
