// Processing-store registry — every store this worker can reach.
//
// It exists because both repositories' compliance gates read exactly one
// filesystem input, the Drizzle table directory, so everything they could see
// was a database column by construction. A store missing from here is
// invisible to compliance, which is how report PDFs came to have no expiry
// rule and Durable Objects no deletion path.
//
// FOUR RULES.
//
// 1. `retention_rule` is a POINTER, never a copy. Windows live in
//    `server/lib/compliance/retention-manifest.ts`; an entry names the rule
//    and the gate resolves it. A restated window is a second source of truth
//    for one fact, and the two will disagree.
// 2. `role` is a jurisdiction MAP whose coordinates are OBJECTS carrying their
//    basis, never bare strings — a bare string asserts a legal classification
//    our own contract is not entitled to make. An undetermined coordinate is
//    `legal_role: "unclassified"` with a null basis: never omitted, never
//    guessed. The gate counts unclassified coordinates beside the total so a
//    registry full of unknowns can never read as classified.
// 3. The two California "business" determinations are ENTITY facts, not store
//    facts, so they live once at the top of this file rather than repeated on
//    every entry. §1798.140(d) (threshold: $26,625,000 / 100k consumers /
//    50% of revenue) decides whether the service-provider framework engages;
//    §1798.80(a) ("whether or not organized for profit", no threshold) is what
//    §1798.81.5's security duty and §1798.82(b)'s maintainer duty attach to.
//    One flag would answer both with one bit, and they disagree. The per-store
//    `role.US_CA` coordinate is a different question again — what WE are with
//    respect to that store's data — and takes the vocabulary in the framework
//    document's §3.
// 4. `evidence_level` describes the evidence for THIS ENTRY'S CLAIMS about
//    deletion and export, not confidence in the description. Every entry ships
//    at E2 (source-verified) because that is what reading the code buys. E3
//    (production-verified) requires a recorded production observation, and no
//    store has one — the absence is written down rather than rounded up.
//    Ladder: E0 proposal · E1 implemented · E2 source-verified ·
//    E3 production-verified · E4 observed user state.
//
// Verified against both wrangler configs and the source on 2026-08-17.
{
  // ── Entity-level facts (rule 3) ───────────────────────────────────────────
  // Both undetermined. Neither can be answered from this repository: the first
  // needs revenue and consumer-volume figures, the second needs the operating
  // entity's legal form. They are written as open questions because the
  // alternative — omitting them — reads as "not applicable".
  "california_business_determinations": {
    "CCPA_business_1798_140": {
      "determination": "undetermined",
      "basis": null,
      "determined_at": null,
      "source": null,
      "question": "Does the operating entity exceed $26,625,000 annual revenue (CPI-adjusted, effective 2025-01-01), buy/sell/share the personal information of 100,000+ California consumers or households, or derive 50% or more of annual revenue from selling or sharing personal information? Any one suffices."
    },
    "customer_records_business_1798_80": {
      "determination": "undetermined",
      "basis": null,
      "determined_at": null,
      "source": null,
      "question": "Is the operating entity a sole proprietorship, partnership, corporation, association or other group, whether or not organized for profit? There is no threshold, so this is expected to resolve to yes once the entity's form is stated — and it is what §1798.81.5's reasonable-security duty and §1798.82(b)'s maintainer duty attach to, independently of the answer above."
    }
  },

  "stores": [
    // ── Databases ───────────────────────────────────────────────────────────
    {
      "store_type": "d1",
      "binding": "DB",
      "modes": ["standalone", "saas"],
      "role": {
        "EU":    { "legal_role": "processor",    "basis": "tos.json §5 — the tenant determines purposes and means for end-client data", "determined_at": "2026-08-15", "source": "contract + review" },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "engine",
      "data_categories": ["inspection_content", "contact", "staff_account", "agreement_evidence"],
      "subjects": ["end_client", "agent", "staff", "platform_staff"],
      "purpose": "The system of record for inspections, contacts, agreements and accounts.",
      "retention_rule": "engine:RETENTION_MANIFEST",
      "deletion_mechanism": "tenant-purge.service.ts cascade over tenantScopedTables()",
      "export_mechanism": "subject-data.assembler.ts + data-export.service.ts",
      "tenant_scope": "per-tenant",
      "evidence_level": "E2"
    },

    // ── Key-value ───────────────────────────────────────────────────────────
    {
      "store_type": "kv",
      "binding": "TENANT_CACHE",
      "modes": ["standalone", "saas"],
      "role": {
        "EU":    { "legal_role": "processor",    "basis": "tos.json §5 — a cache of the tenant's own configuration, held on their instruction", "determined_at": "2026-08-15", "source": "contract + review" },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "engine",
      "data_categories": ["tenant_config", "integration_secrets", "session_invalidation"],
      "subjects": ["staff"],
      "purpose": "Tenant configuration and decrypted-secret cache (`tenant:{slug}`, `secrets_enc`), plus the password-change stamps (`pwchanged:{userId}`) that invalidate JWTs issued before a credential change, and the agent view tokens.",
      "retention_rule": "none",
      "deletion_mechanism": "tenant-purge.service.ts — three named keys plus an `agent_view_token:{tenantIdHex}` prefix sweep",
      "export_mechanism": "not-applicable",
      "tenant_scope": "mixed",
      "evidence_level": "E2",
      "note": "Share tokens are now reachable: the token carries its tenant in its leading 32 hex characters, so `kv.list({prefix})` enumerates exactly one tenant's — see lib/agent-view-token.ts for why the token and not the key had to carry it. Two residues, both bounded and both asserted by tests rather than assumed: tokens minted before that change carry nothing saying whose they are and expire inside their own 30-day TTL, and `pwchanged:{userId}` is keyed by user id — swept by name from the user list, and in any case a non-personal stamp (a user id and a timestamp) whose only reader is the auth middleware."
    },
    {
      "store_type": "kv",
      "binding": "OAUTH_KV",
      "modes": ["standalone", "saas"],
      "role": {
        "EU":    { "legal_role": "processor",    "basis": "tos.json §5 — OAuth state for integrations the tenant chose to connect", "determined_at": "2026-08-15", "source": "contract + review" },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "engine",
      "data_categories": ["oauth_state", "mcp_grant"],
      "subjects": ["staff"],
      "purpose": "Two unrelated tenants share this namespace because the binding name is fixed by @cloudflare/workers-oauth-provider: the calendar connect flow's `cal-oauth:{state}` handshake rows, and the remote-MCP OAuth provider's own grant and token records.",
      "retention_rule": "provider-managed",
      "deletion_mechanism": "ttl",
      "export_mechanism": "not-applicable",
      "tenant_scope": "mixed",
      "evidence_level": "E2",
      "note": "Both writers set a TTL, so nothing here outlives its handshake or grant; what neither has is a tenant-prefixed key, so neither is reachable by a tenant purge. Accepted for the calendar state (a random nonce with a short TTL); the MCP grant records are the library's own shape and are not ours to re-key."
    },

    // ── Object storage ──────────────────────────────────────────────────────
    {
      "store_type": "r2",
      "binding": "PHOTOS",
      "modes": ["standalone", "saas"],
      "role": {
        "EU":    { "legal_role": "processor",    "basis": "tos.json §5 — the tenant determines purposes and means for inspection media and deliverables", "determined_at": "2026-08-15", "source": "contract + review" },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "engine",
      "data_categories": ["inspection_media", "agreement_pdf", "report_pdf", "evidence_pack"],
      "subjects": ["end_client", "staff"],
      "purpose": "Photographs, video, rendered report PDFs, signed agreements and evidence packs.",
      "retention_rule": "engine:RETENTION_MANIFEST",
      "deletion_mechanism": "tenant-purge.service.ts four-prefix sweep",
      "export_mechanism": "data-export.service.ts",
      "tenant_scope": "per-tenant",
      "evidence_level": "E2",
      "note": "Both halves are now covered. Destruction: the four-prefix sweep. Retention: report PDFs expire on a per-tenant window (report_pdfs rule; 0 = indefinite is a controller instruction), and the three signed-agreement artefacts — signed.pdf, certificate.pdf, evidence.zip — are destroyed by the agreement sweep in the same pass that nulls the signature column, because nulling the column while the PDF still embeds the image is database retention wearing the name of retention (review review). What is still UNGOVERNED here is inspection media: photographs and video have no expiry rule of their own and live until the tenant does."
    },
    {
      "store_type": "r2",
      "binding": "EXPORTS_BUCKET",
      "modes": ["saas"],
      "role": {
        "EU":    { "legal_role": "processor",    "basis": "tos.json §5 — an export assembled on the tenant's or their data subject's instruction", "determined_at": "2026-08-15", "source": "contract + review" },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "engine",
      "data_categories": ["subject_data_export", "tenant_offboarding_archive"],
      "subjects": ["end_client", "agent", "staff"],
      "purpose": "Where a completed data export or offboarding archive is written for portal to hand to the requester. A single object here can hold everything the other stores hold about one person.",
      "retention_rule": "none",
      "deletion_mechanism": "none",
      "export_mechanism": "not-applicable",
      "tenant_scope": "per-tenant",
      "evidence_level": "E2",
      "note": "The highest-concentration store in the registry and the one with no clock: an export bundles a subject's whole record into one object and nothing expires it. Absent from standalone entirely — the offboarding command path is SaaS-only."
    },

    // ── Durable Objects ─────────────────────────────────────────────────────
    {
      "store_type": "durable_object",
      "binding": "INSPECTION_DOC",
      "modes": ["standalone", "saas"],
      "role": {
        "EU":    { "legal_role": "processor",    "basis": "tos.json §5 — the tenant determines purposes and means for the report content edited here", "determined_at": "2026-08-15", "source": "contract + review" },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "engine",
      "data_categories": ["inspection_content", "inspector_prose", "photo_keys"],
      "subjects": ["end_client", "staff"],
      "purpose": "Collaborative editing host: one Yjs document per report, plus up to 25 projection snapshots.",
      "retention_rule": "none",
      "deletion_mechanism": "tenant-purge.service.ts POSTs /purge to one object per report id, collected pre-cascade",
      "export_mechanism": "none",
      "tenant_scope": "per-tenant",
      "evidence_level": "E2",
      "note": "Addressed by `${tenantId}:${reportId}` — see collabDocName — so the purge collects the tenant's report ids BEFORE the cascade deletes the rows they come from. A purge that cannot confirm this store records `durable_objects` as incomplete on the destruction record rather than reporting success. RETENTION is still absent: nothing expires a document while the tenant lives."
    },
    {
      "store_type": "durable_object",
      "binding": "TENANT_PRESENCE",
      "modes": ["standalone", "saas"],
      "role": {
        "EU":    { "legal_role": "processor",    "basis": "tos.json §5 — presence is generated on the tenant's instruction while their staff work", "determined_at": "2026-08-15", "source": "contract + review" },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "engine",
      "data_categories": ["presence_only", "staff_identity"],
