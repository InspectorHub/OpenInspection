    },
    {
      "store_type": "stream",
      "binding": "STREAM",
      "modes": ["standalone", "saas"],
      "env_vars": ["STREAM_CUSTOMER_SUBDOMAIN"],
      "role": {
        "EU":    { "legal_role": "processor",    "basis": "tos.json §5 — inspection video the tenant's staff recorded", "determined_at": "2026-08-17", "source": "contract + review" },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "platform",
      "data_categories": ["inspection_media"],
      "subjects": ["end_client", "staff"],
      "purpose": "Video backend when a deployment selects Stream over R2 — stores the uploaded video and serves playback from the customer subdomain.",
      "retention_rule": "none",
      "deletion_mechanism": "unknown",
      "export_mechanism": "unknown",
      "tenant_scope": "not-tenant-scoped",
      "evidence_level": "E2",
      "note": "Account-scoped, not tenant-scoped: the binding is name-only and a Stream video id carries no tenant. Whether the tenant purge reaches Stream-hosted video is UNKNOWN and written as unknown — the R2 sweep is a prefix walk and Stream is not R2."
    },
    {
      "store_type": "rate_limiter",
      "binding": "RATE_LIMITER",
      "modes": ["standalone", "saas"],
      "role": {
        "EU":    { "legal_role": "controller",   "basis": "Abuse prevention on our own public endpoints is our purpose, not the tenant's instruction — framework §3, platform-operational row", "determined_at": "2026-08-17", "source": "framework §3" },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "platform",
      "data_categories": ["ip_address"],
      "subjects": ["end_client", "staff", "anonymous_visitor"],
      "purpose": "Per-IP request counting on public endpoints.",
      "retention_rule": "window-bounded",
      "deletion_mechanism": "not-applicable",
      "export_mechanism": "not-applicable",
      "tenant_scope": "not-tenant-scoped",
      "evidence_level": "E2",
      "note": "The key is `{prefix}:{ip}` and the window is 60 seconds, so an IP is held for at most a minute and no counter survives it. The one entry here whose subject includes a visitor who never became a customer."
    },
    {
      "store_type": "static_assets",
      "binding": "ASSETS",
      "modes": ["standalone", "saas"],
      "role": {
        "EU":    { "legal_role": "controller",   "basis": "Our own built client bundle — no personal data and no tenant instruction involved", "determined_at": "2026-08-17", "source": "framework §3" },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "platform",
      "data_categories": [],
      "subjects": [],
      "purpose": "The built client bundle and public static files.",
      "retention_rule": "not-applicable",
      "deletion_mechanism": "not-applicable",
      "export_mechanism": "not-applicable",
      "tenant_scope": "not-tenant-scoped",
      "evidence_level": "E2",
      "note": "Registered with empty data_categories and subjects on purpose. A binding absent from the registry is indistinguishable from one nobody looked at; a binding present with nothing in it is a reviewed answer."
    },

    // ── External processors (not bindings) ──────────────────────────────────
    // These are sub-processors reached over the network. They are the half of
    // the registry a binding count cannot see, which is why the gate counts
    // them separately and refuses to merge the two numbers.
    {
      "store_type": "external_processor",
      "binding": null,
      "external_processor": "server/lib/email/providers/resend.ts",
      "modes": ["standalone", "saas"],
      "env_vars": ["SENDER_EMAIL"],
      "role": {
        "EU":    { "legal_role": "processor",    "basis": "tos.json §5 — mail sent on the tenant's instruction to their own contacts; the tenant may supply their own Resend key and sender", "determined_at": "2026-08-17", "source": "contract + review" },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "vendor",
      "data_categories": ["contact", "message_content"],
      "subjects": ["end_client", "agent", "staff"],
      "purpose": "Transactional email delivery — the platform default provider, and the one a tenant most often re-points at their own account.",
      "retention_rule": "vendor-managed",
      "deletion_mechanism": "vendor-contract",
      "export_mechanism": "none",
      "tenant_scope": "per-tenant",
      "evidence_level": "E2",
      "note": "A recipient address and the message body leave our estate here. What the vendor keeps and for how long is theirs; the record that we sent it is `automation_logs`, retained indefinitely by design."
    },
    {
      "store_type": "external_processor",
      "binding": null,
