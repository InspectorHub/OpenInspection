      "modes": ["standalone", "saas"],
      "env_vars": ["AI_MODEL"],
      "role": {
        "EU":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CA": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "US_CO": { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null },
        "CA":    { "legal_role": "unclassified", "basis": null, "determined_at": null, "source": null }
      },
      "lifecycle_owner": "vendor",
      "data_categories": ["inspection_content", "inspector_prose"],
      "subjects": ["end_client", "staff"],
      "purpose": "AI translation and drafting. Two credential paths: a tenant's own key, or the deployment's managed key for entitled tenants.",
      "retention_rule": "vendor-managed",
      "deletion_mechanism": "vendor-contract",
      "export_mechanism": "none",
      "tenant_scope": "per-tenant",
      "evidence_level": "E2",
      "note": "The one external processor whose EU coordinate is left UNCLASSIFIED rather than asserted as processor, and deliberately: the framework's own roles-by-product-area table calls BYO-key AI 'complicated' — the tenant chooses the account while we choose the provider, model, prompts, ledger and posture — and managed AI puts Art. 28(10) live. Writing 'processor' here would be exactly the self-labelling §3 forbids. What leaves the process on either key is enumerated in docs/compliance/ai-data-flow.md."
    }
