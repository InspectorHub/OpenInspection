# Cloudflare config — wrangler.jsonc (standalone, PLACEHOLDER ids) IS committed as the
# public OSS / one-click-deploy default (CF auto-provisions resources + injects real ids).
# Real ids / private configs live in gitignored variant files:
#   wrangler.local.jsonc — your real standalone ids (scripts/setup-cloudflare.js writes it)
#   wrangler.saas.jsonc  — InspectorHub private SaaS config
wrangler.*.jsonc
wrangler.toml
wrangler.*.toml

# Deploy toml variants
*.wrangler-deploy.toml

# Qwen config
.qwen/
.worktrees/
.tsbuildinfo*
.eslintcache

# tsc project-reference output: the .d.ts tsconfig.api.json emits for the app
# program to consume. Build output — NEVER commit it. `tsc -b` rebuilds it from
# input timestamps, which is the only thing keeping it honest; a committed copy
# goes stale and produces cross-boundary errors with no matching source.
.types/

# drizzle-kit schema-first: generated/temp artifacts (db:check regenerates drizzle-tmp)
drizzle-tmp/
drizzle-introspect/
drizzle-introspect-db.sqlite
.claude/

# Transient wipe-d1 scratch SQL (scripts/wipe-d1.mjs cleans these up; ignore in case of crash)
.wipe-d1.*.sql

# SDD scratch (briefs, reports, diffs, progress ledger)
.superpowers/
.gate-cache/

# Generated user-guide captures — the published copies live in the CMS.
.docs-shots/

# Transient calibration probe written by scripts/check-e2e-spec-coverage.mjs
# while it runs, and deleted in a finally. Ignored so an interrupted run cannot
# leave a spec nothing collects in a commit; the gate refuses to start when the
# file is present and names it.
tests/e2e/zz-e2e-coverage-probe.spec.ts

# Vitest run reports — a durable record of every run, so an intermittent
# failure is diagnosable after the fact rather than only while watching.
.vitest/

# Test-run logs — full stdout per run, so an intermittent failure is
# diagnosable after the fact. See scripts/run-logged.mjs.
.runlogs/


# Authority-published statutory form PDFs. These are the states' own
# documents: this repository records only their sha256 (see the field maps
# under server/lib/statutory/forms/), never their bytes. Ignored by name so
# that dropping the source files here to work on a field map cannot commit
# them by accident.
# ⚠️ ANCHORED. Written bare, this pattern matches a directory of that name at
# ANY depth -- which silently swallowed tests/unit/statutory-forms/ and made
# every NEW spec added there invisible to git. Tracked files kept working, so
# nothing failed; the next spec would simply not have been committed.
/statutory-forms/
