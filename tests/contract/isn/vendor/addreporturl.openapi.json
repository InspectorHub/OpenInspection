{
  "openapi": "3.1.0",
  "info": { "title": "ISN REST API", "version": "8665" },
  "servers": [
    {
      "url": "https://{host}/{companyKey}/rest",
      "description": "ISN, scoped to your company key",
      "variables": {
        "host": { "default": "inspectionsupport.com", "description": "Your ISN domain. White-label accounts use their own." },
        "companyKey": { "default": "test", "description": "Your ISN company key." }
      }
    }
  ],
  "paths": {
    "/orders/addreporturl": {
      "put": {
        "summary": "Add report url",
        "requestBody": {
          "required": false,
          "description": "**`application/x-www-form-urlencoded` only.** A JSON body is ignored on this verb: every field arrives empty and the request still returns 200.",
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": { "type": ["string", "null"] },
                  "public": { "type": "boolean" },
                  "title": { "type": ["string", "null"] },
                  "url": { "type": ["string", "null"] },
                  "uuid": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
