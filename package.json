    "happy-dom": "^20.9.0",
    "jscpd": "^5.0.11",
    "knip": "^6.31.0",
    "konva": "^10.2.5",
    "lint-staged": "^16.4.0",
    "miniflare": "^4.20260405.0",
    "patch-package": "^8.0.1",
    "swagger-ui-dist": "^5.32.6",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.22.3",
