{
  "name": "openinspection",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/InspectorHub/OpenInspection.git"
  },
  "homepage": "https://inspectorhub.io",
  "bugs": {
    "url": "https://github.com/InspectorHub/OpenInspection/issues"
  },
  "cloudflare": {
    "label": "OpenInspection",
    "products": [
      "Workers"
    ],
    "categories": [
      "starter"
    ],
    "docs_url": "https://github.com/InspectorHub/OpenInspection#readme",
    "publish": true
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "npm run build && wrangler dev -c build/server/wrangler.json --persist-to .wrangler/state --port 8787",
    "dev:hmr": "npm run vendor:copy && react-router dev",
    "dev:tunnel": "npm run build && wrangler dev -c build/server/wrangler.json --persist-to .wrangler/state --tunnel",
    "build": "npm run vendor:copy && node scripts/gen-version.js && react-router build",
    "preview": "npm run build && wrangler dev -c build/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "npm run build && npm run db:migrate:remote && npm run db:lag && wrangler deploy -c build/server/wrangler.json && npm run jwt:ensure && npm run setup-code:ensure",
    "deploy:saas": "cross-env WRANGLER_CONFIG=wrangler.saas.jsonc npm run build && npm run db:migrate:saas:remote && npm run db:lag:saas && wrangler deploy -c build/server/wrangler.json && cross-env WRANGLER_CONFIG=wrangler.saas.jsonc npm run jwt:ensure",
    "jwt:ensure": "node scripts/ensure-jwt-secrets.mjs",
    "setup-code:ensure": "node scripts/ensure-setup-code.mjs",
    "vendor:copy": "node scripts/vendor-copy.js",
    "gen-version": "node scripts/gen-version.js",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./app/paraglide --strategy cookie baseLocale --output-structure locale-modules --emit-ts-declarations",
    "type-check": "npm run i18n:compile && react-router typegen && npm run type-check:app && npm run type-check:api && npm run type-check:e2e && npm run type-check:tests",
    "type-check:app": "node --max-old-space-size=12288 ./node_modules/typescript/bin/tsc -b tsconfig.json",
    "type-check:api": "node --max-old-space-size=12288 ./node_modules/typescript/bin/tsc -b tsconfig.api.json",
    "type-check:e2e": "node --max-old-space-size=12288 ./node_modules/typescript/bin/tsc -b tsconfig.api.json && node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc -p tsconfig.playwright.json --noEmit",
    "type-check:tests": "node --max-old-space-size=12288 ./node_modules/typescript/bin/tsc -b tsconfig.api.json && node --max-old-space-size=1536 ./node_modules/typescript/bin/tsc -p tsconfig.tests.json --noEmit",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=12288 eslint . --cache --cache-strategy content && node scripts/run-gates.mjs",
    "lint:advisories": "node scripts/check-advisories.mjs --level=high",
    "lint:ds": "node scripts/check-ds-tokens.mjs",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:agent-routes": "node scripts/check-agent-routes.mjs",
    "lint:agent-terms-classification": "node scripts/check-agent-terms-classification.mjs",
    "lint:naming": "node scripts/check-naming.mjs",
    "lint:svg": "node scripts/check-svg-dimensions.mjs",
    "lint:erasure": "node scripts/check-erasure-manifest.mjs",
    "lint:retention": "node scripts/check-retention-manifest.mjs",
    "lint:retention-policy": "node scripts/check-retention-policy.mjs",
    "lint:processing-stores": "node scripts/check-processing-stores.mjs",
    "lint:platform-defaults": "node scripts/check-platform-defaults.mjs",
    "lint:non-translatable": "node scripts/check-non-translatable.mjs",
    "lint:audit-registry": "node scripts/check-audit-registry.mjs",
    "lint:migrefs": "node scripts/check-migration-refs.mjs",
    "lint:chrome-record": "node scripts/check-chrome-record.mjs --self-test",
    "lint:migchain": "node scripts/check-migration-chain.mjs",
    "lint:zero-tracking": "node scripts/check-zero-tracking.mjs",
    "lint:ai-classification": "node scripts/check-ai-classification.mjs",
    "lint:price-capability": "node scripts/check-price-capability.mjs",
    "lint:filesize": "node scripts/check-file-size.mjs",
    "lint:item-key-parity": "node scripts/check-item-key-parity.mjs",
    "lint:columns": "node scripts/check-column-ceiling.mjs",
    "lint:converter-capability": "node scripts/check-converter-capability.mjs",
    "lint:converter-literals": "node scripts/check-converter-literals.mjs",
    "lint:statutory-answerable": "node scripts/check-statutory-answerable.mjs",
    "lint:statutory-fidelity": "node scripts/check-statutory-fidelity.mjs",
    "lint:statutory-additive": "node scripts/check-statutory-versions-additive.mjs",
    "lint:catalogue-writes": "node scripts/check-catalogue-write-points.mjs",
    "lint:marketplace-kind-halves": "node scripts/check-marketplace-kind-halves.mjs",
    "verify:real-corpus": "node scripts/verify-real-corpus.mjs",
    "verify:statutory-render": "tsx scripts/verify-statutory-render.mjs",
    "lint:dup": "jscpd server app packages",
    "lint:gates": "node scripts/run-gates.mjs --rung precommit",
    "lint:gate-registry": "node scripts/check-gate-registry.mjs",
    "lint:private-review": "node scripts/check-no-private-review-refs.mjs",
    "lint:tenant-scope": "node scripts/check-tenant-scoping.mjs",
    "lint:status-literals": "node scripts/check-status-literals.mjs",
    "lint:capability-decl": "node scripts/check-capability-declarations.mjs",
    "lint:capability-readers": "node scripts/check-capability-readers.mjs",
    "lint:mode-disguises": "node scripts/check-mode-disguises.mjs",
    "lint:provider-helpers": "node scripts/check-provider-helpers.mjs",
    "lint:notification-dispatch": "node scripts/check-notification-dispatch.mjs",
    "lint:tests": "node scripts/check-test-layout.mjs",
    "lint:e2e-coverage": "node scripts/check-e2e-spec-coverage.mjs",
    "lint:tests-tsconfig": "node scripts/check-tests-tsconfig.mjs",
    "lint:test-imports": "node scripts/check-test-imports.mjs",
    "lint:cron-budget": "node scripts/check-cron-budget.mjs",
    "lint:content-version": "node scripts/check-content-version.mjs",
    "lint:deadcode": "node scripts/check-deadcode.mjs",
    "lint:timestamps": "node scripts/check-timestamps.mjs",
    "lint:tz": "node scripts/check-tz-safety.mjs",
    "lint:idempotency": "node scripts/check-idempotency-coverage.mjs",
    "lint:ext-collisions": "node scripts/check-extension-collisions.mjs",
    "lint:raw-nul": "node scripts/check-raw-nul.mjs",
    "lint:eol": "node scripts/check-line-endings.mjs",
    "lint:wrangler-patch": "node scripts/check-wrangler-patch.mjs",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:i18n-catalog": "node scripts/check-i18n-catalog.mjs",
    "lint:i18n-glossary": "node scripts/check-i18n-glossary.mjs",
    "check:ts-range": "node scripts/check-ts-range.mjs",
    "lint:fix": "eslint . --fix --cache",
    "security-scan": "npm audit --audit-level=high",
    "test:unit": "node scripts/run-logged.mjs unit -- vitest run --config vitest.api.config.ts",
    "test:leaks": "vitest run --config vitest.api.config.ts --detect-async-leaks --testTimeout=120000 --hookTimeout=180000",
    "test:unit:isolation-debt": "vitest run --config vitest.api.config.ts --no-isolate",
    "test:unit:changed": "vitest run --changed --config vitest.api.config.ts",
    "test:web": "node scripts/run-logged.mjs web -- vitest run --config vitest.config.ts",
    "test:web:changed": "vitest run --changed --config vitest.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:contract:live": "vitest run --config vitest.contract.live.config.ts",
    "test:workers": "node scripts/run-logged.mjs workers -- vitest run --config vitest.workers.config.ts",
    "test:types": "cross-env NODE_OPTIONS=--max-old-space-size=12288 tsc -b tsconfig.api.json && cross-env NODE_OPTIONS=--max-old-space-size=8192 vitest run --typecheck --config vitest.typecheck.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:seeded": "playwright test -c playwright.seeded.config.ts",
    "db:migrate": "node scripts/wrangler.mjs d1 migrations apply DB --local",
    "seed:local": "node scripts/seed-local-e2e.mjs",
    "db:migrate:remote": "node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "db:migrate:saas:remote": "cross-env WRANGLER_CONFIG=wrangler.saas.jsonc node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "db:check": "node scripts/verify-migration-equivalence.mjs",
    "db:lag": "node scripts/check-migration-lag.mjs",
    "db:lag:local": "node scripts/check-migration-lag.mjs --local --label local-d1",
    "db:lag:saas": "cross-env WRANGLER_CONFIG=wrangler.saas.jsonc node scripts/check-migration-lag.mjs --label saas",
    "db:generate": "drizzle-kit generate",
    "agent-terms:publish": "node scripts/publish-agent-terms.mjs",
    "wipe:d1:local": "node scripts/wipe-d1.mjs --local",
    "wipe:d1:remote": "node scripts/wipe-d1.mjs --remote",
    "wipe:d1:saas:remote": "cross-env WRANGLER_CONFIG=wrangler.saas.jsonc node scripts/wipe-d1.mjs --remote",
    "seed:test-user": "node scripts/seed-test-user.mjs",
    "setup:cloudflare": "node scripts/setup-cloudflare.js",
    "setup:local": "node scripts/setup-cloudflare.js --local",
    "teardown:cloudflare": "node scripts/teardown-cloudflare.js",
    "teardown:local": "node scripts/teardown-cloudflare.js --local --force",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "rotate:jwt": "node scripts/rotate-jwt-keys.js",
    "bootstrap": "node scripts/gen-version.js && npm run vendor:copy",
    "prepare": "node -e \"const{execSync}=require('child_process');try{execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){};try{execSync('node scripts/gen-version.js',{stdio:'ignore'})}catch(e){};try{execSync('npm run i18n:compile',{stdio:'ignore'})}catch(e){}\"",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "mcp:snapshot": "node scripts/snapshot-openapi.mjs",
    "lint:english": "node scripts/check-english-only.mjs",
    "lint:eslint": "cross-env NODE_OPTIONS=--max-old-space-size=12288 eslint . --cache --cache-strategy content",
    "lint:gates-full": "node scripts/run-gates.mjs",
    "i18n:compile:cached": "node scripts/i18n-compile-if-changed.mjs",
    "lint:submit-guard": "node scripts/check-submit-guard.mjs",
    "lint:seed-sql": "node scripts/check-seed-sql.mjs",
    "lint:schema-doc": "node scripts/gen-schema-doc.mjs --check",
    "lint:fabricated-names": "node scripts/check-fabricated-names.mjs",
    "lint:signature-dynamics": "node scripts/check-signature-dynamics.mjs",
    "lint:sigcompare": "node scripts/check-signature-compare.mjs",
    "lint:sms-gate-args": "node scripts/check-sms-gate-args.mjs",
    "lint:messaging-rules": "node scripts/check-messaging-rules.mjs",
    "lint:consent-subjects": "node scripts/check-consent-subject-kinds.mjs",
    "lint:verification-copy": "node scripts/check-verification-copy.mjs",
    "lint:endorsement-copy": "node scripts/check-endorsement-copy.mjs",
    "lint:view-invariants": "node scripts/check-view-tracking-invariants.mjs",
    "docs:schema": "node scripts/gen-schema-doc.mjs",
    "docs:modes": "tsx scripts/gen-deployment-modes-doc.ts",
    "lint:doclinks": "node scripts/check-doc-links.mjs",
    "lint:no-portal-routes": "node scripts/check-no-portal-routes.mjs",
    "docs:shots": "playwright test -c playwright.docs-shots.config.ts",
    "lint:unwired": "node scripts/check-unwired.mjs",
    "lint:url-taxonomy": "node scripts/check-url-taxonomy.mjs",
    "lint:route-dispatch": "node scripts/check-route-dispatch-parity.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@conform-to/react": "^1.19.4",
    "@conform-to/zod": "^1.19.4",
    "@googlemaps/js-api-loader": "^1.16.10",
    "@inlang/paraglide-js": "2.22.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stripe/react-stripe-js": "^6.5.0",
    "@stripe/stripe-js": "^9.7.0",
    "@types/sortablejs": "^1.15.9",
    "agents": "^0.17.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.9",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.0",
    "isbot": "^5.1.0",
    "lib0": "^0.2.117",
    "nanoid": "^5.1.5",
    "otpauth": "^9.5.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.0.2",
    "react-konva": "^19.2.5",
    "react-photo-album": "^3.6.0",
    "react-router": "^8.3.0",
    "sortablejs": "^1.15.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^2.6.1",
    "write-excel-file": "^4.1.1",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yet-another-react-lightbox": "^3.32.0",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
