{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "references": [
    { "path": "api" },
    { "path": "frontend" }
  ],
  "include": ["scripts/**/*"],
  "exclude": ["node_modules"]
}
