{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "workers/app.ts",
    "server/index.ts",
    "app/routes.ts",
    "app/root.tsx",
    "app/entry.server.tsx",
    "app/routes/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,ts}",
    "*.config.{ts,js,mjs}",
    "react-router.config.ts",
    "drizzle.config.ts",
    "drizzle.config.trial.ts",
    "playwright.config.ts",
    "playwright.integration.config.ts",
    "playwright.remote.config.ts",
    "vitest.api.config.ts",
    "vitest.config.ts",
    "vitest.typecheck.config.ts",
    "vitest.workers.config.ts",
    "vite.config.ts",
    "packages/field-ui/src/components/media-studio/react-konva.ssr-stub.tsx",
    "server/lib/compliance/retention-policy.ts",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "tests/**/*.ts",
    "packages/shared-ui/src/index.ts",
    "packages/api-types/index.ts",
    "packages/offline-package/index.ts",
    "packages/field-ui/src/index.ts",
    "packages/field-ui/src/testing/fake-data-source.ts",
    "packages/field-ui/tsup.config.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "server/**/*.{ts,tsx}",
    "workers/**/*.ts",
    "packages/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,ts}"
  ],
  "ignore": [
    "build/**",
    ".react-router/**",
    "public/vendor/**",
    "public/fonts/**",
    "node_modules/**",
    ".worktrees/**",
    "server/generated/**",
    "scripts/fixtures/**",
    "worker-configuration.d.ts",
    "**/*.d.ts"
  ],
  "tags": [
    "-gateConsumed",
    "-declarationEmit"
  ],
  // Top-level options configure the ROOT workspace only. packages/field-ui is a workspace of its own and is
  // checked by knip with its own package.json: an unlisted import there is reported (verified by adding one),
  // so nothing below hides a field-ui dependency problem. What it hides is the ROOT's view of these names.
  "ignoreDependencies": [
    // Tooling the config files and scripts use without importing: knip cannot see the use.
    "@fontsource/.+",
    "swagger-ui-dist",
    "tailwindcss",
    "miniflare",
    "lint-staged",
    "cloudflare",
    "@inlang/plugin-message-format",
    // Path aliases (tsconfig paths and vite aliases), not packages.
    "@core/shared-ui",
    "@core/api-types",
    "@core/offline-package",
    // Declared in the root package.json but imported only by packages/field-ui since the editor moved there
    // (they are its peerDependencies). Left declared at the root on purpose: the root build resolves them from
    // the root node_modules. Without this, knip reports each as an unused root dependency. The way to stop
    // ignoring them is to drop them from the root package.json (npm installs a workspace's peers), which is
    // a package.json and lockfile change and belongs in its own commit.
    "react-photo-album",
    "yet-another-react-lightbox",
    "react-easy-crop",
    "react-konva",
    "konva",
    "sortablejs"
  ]
}
